{
  "name": "borrower-copilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Borrower-side self-assessment for Indian lending: should I borrow, how much, at what rate, at what EMI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "npm run docs:rules && npm run docs:runthroughs",
    "docs:rules": "tsx scripts/genRules.ts",
    "docs:runthroughs": "tsx scripts/genRunthroughs.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
